# =============================================================================
# TRUE STORY  ·  environment template
# =============================================================================
# Copy to .env and fill in. Nothing in this file is read at runtime in
# production: on Google Cloud every secret is resolved from Secret Manager and
# these variables only name the secret. Locally, .env is loaded by
# truestory.config so that `make dev` works with zero cloud dependencies.
#
#   cp .env.example .env
#
# Values marked PLACEHOLDER are wired in the TODO section of the README.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Runtime mode
# -----------------------------------------------------------------------------
# mock   : no network, no spend, fixtures only. The default. CI runs here.
# cached : replays recorded provider responses, falls through to live on miss.
# live   : real Parallel and real Vertex AI calls. Costs money.
TRUESTORY_MODE=mock

# debug | info | warning | error
TRUESTORY_LOG_LEVEL=info

# Emitted into every Evidence record and every report footer.
TRUESTORY_ENV=local


# -----------------------------------------------------------------------------
# 2. Google Cloud
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=PLACEHOLDER_project_id
# `global`, not a region. Every Gemini 3 model 404s from us-central1 and
# serves normally from global. The 2.5 models work from both, so a regional
# value fails silently by capping you at the previous generation.
GOOGLE_CLOUD_LOCATION=global

# Path to a service account key for local development only.
# On Cloud Run and Agent Engine leave this unset and use the attached identity.
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI rather than the public Gemini endpoint.
GOOGLE_GENAI_USE_VERTEXAI=true

# Models, one slot per decision point. An unavailable name degrades through the
# fallback chain rather than ending a run, so verify with `truestory doctor
# --models` and change these freely.
#
# Reasoned, not measured: the prompts were written against the 2.5 generation.
# Confirm any change against demo/screenplay/forty_five_minutes.fountain before
# quoting an accuracy number that depends on it.
TRUESTORY_MODEL_INGEST=gemini-3.7-flash
TRUESTORY_MODEL_CLAIMS=gemini-3.1-pro-preview
TRUESTORY_MODEL_ADJUDICATOR=gemini-3.1-pro-preview
TRUESTORY_MODEL_REMEDY=gemini-3.7-flash
TRUESTORY_MODEL_ATTRIBUTION=gemini-3.7-flash
TRUESTORY_MODEL_IDENTITY=gemini-3.7-flash
# Stays on a flash model for a measured reason: 2.5-pro answered this prompt
# from parametric knowledge and returned zero grounding chunks, where flash
# searched and returned five to seven. Check the chunk count before moving it.
TRUESTORY_MODEL_GROUNDED=gemini-3.7-flash

# Vertex AI Agent Engine. Populated by `make deploy-agent`.
AGENT_ENGINE_RESOURCE_NAME=
AGENT_ENGINE_STAGING_BUCKET=gs://PLACEHOLDER_project_id-truestory-staging


# -----------------------------------------------------------------------------
# 3. Parallel Web Systems
# -----------------------------------------------------------------------------
# Get a key at https://platform.parallel.ai  (see README TODO section)
# In production this is resolved from Secret Manager, never from env.
# Accepts a comma separated list, tried in order. A clearance run dispatches a
# hundred subjects over several minutes, and a key that drains halfway through
# takes the whole run with it, so a spare is worth configuring before a demo.
PARALLEL_API_KEY=PLACEHOLDER_parallel_key
PARALLEL_API_BASE=https://api.parallel.ai
PARALLEL_TIMEOUT_SECONDS=120

# Processor defaults. routing.yaml overrides these per subject type.
# The -fast suffix keeps the on camera run synchronous at the same price.
PARALLEL_PROCESSOR_LITE=lite
PARALLEL_PROCESSOR_BASE=base
PARALLEL_PROCESSOR_CORE=core
PARALLEL_USE_FAST_VARIANTS=true

# Shared secret used to verify the signature on every inbound callback.
PARALLEL_WEBHOOK_SECRET=PLACEHOLDER_webhook_signing_secret
PARALLEL_WEBHOOK_URL=https://PLACEHOLDER_webhook_service_url/webhooks/parallel


# -----------------------------------------------------------------------------
# 3b. Registers  (optional)
# -----------------------------------------------------------------------------
# Free key, registered at https://developer.uspto.gov. Entirely optional: with
# no key the registry_lookup provider reports unhealthy, every mark falls back
# to Parallel Task, and the run is exactly what it is today.
#
# With a key, BUSINESS_NAME, TRADEMARK_LOGO and BRAND_PRODUCT are answered by
# the register itself. Two things change. The citation becomes tsdr.uspto.gov,
# which source_quality scores as a registry at trust 0.93 rather than as the
# scraper the crawler was returning. And the marks stop costing anything, which
# on a script heavy with signage is most of the coverage half of the budget.
USPTO_API_KEY=PLACEHOLDER_uspto_key
USPTO_API_BASE=https://api.uspto.gov
USPTO_TIMEOUT_SECONDS=30

# Public opinion/docket search works without a credential. A free token enables
# opinion detail, docket entries, and RECAP document retrieval for precedent
# passage verification. Create one in CourtListener account settings.
COURTLISTENER_API_TOKEN=
COURTLISTENER_API_BASE=https://www.courtlistener.com/api/rest/v4


# -----------------------------------------------------------------------------
# 4. Storage
# -----------------------------------------------------------------------------
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=

GCS_BUCKET_SCRIPTS=PLACEHOLDER_project_id-truestory-scripts
GCS_BUCKET_EVIDENCE=PLACEHOLDER_project_id-truestory-evidence
GCS_BUCKET_REPORTS=PLACEHOLDER_project_id-truestory-reports

BIGQUERY_DATASET=truestory
BIGQUERY_TABLE_COST=cost_telemetry
BIGQUERY_TABLE_EVAL=eval_results
BIGQUERY_TABLE_PRECEDENT=precedent_corpus


# -----------------------------------------------------------------------------
# 5. Async plane
# -----------------------------------------------------------------------------
PUBSUB_TOPIC_RESEARCH=truestory-research
PUBSUB_TOPIC_ALERTS=truestory-alerts
PUBSUB_SUBSCRIPTION_RESEARCH=truestory-research-sub

CLOUD_TASKS_QUEUE=truestory-retry
CLOUD_TASKS_LOCATION=us-central1

# Cloud Scheduler sweep that rescues runs whose webhook never arrived.
STALE_RUN_SWEEP_MINUTES=15


# -----------------------------------------------------------------------------
# 6. Budget governance
# -----------------------------------------------------------------------------
# Hard ceiling per script run in US dollars. Exceeding it degrades tiers
# rather than failing the run. See policy/routing.yaml budget_policy.
BUDGET_PER_SCRIPT_USD=5.00
BUDGET_RESERVE_CRITICAL_USD=1.50
BUDGET_DEGRADE_ON_EXCEED=true

# Bounded concurrency for the research swarm. A CONCURRENCY limit, not a rate
# limit. Measured: at 32, zero of 35 subjects completed and every one parked at
# the deadline; at 6, twelve of twelve completed in 141s. Over-dispatching does
# not fail loudly, it queues.
SWARM_MAX_CONCURRENCY=8


# -----------------------------------------------------------------------------
# 7. Web application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_DEMO_RUN_ID=demo-run-0001
NEXT_PUBLIC_ENABLE_COST_METER=true

# Server side only. The web tier calls the API with this identity token.
API_INTERNAL_TOKEN=PLACEHOLDER_internal_token


# -----------------------------------------------------------------------------
# 8. Alerting
# -----------------------------------------------------------------------------
# Optional. Used by the Monitor path to deliver Living Clearance alerts.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
