# gen-lang-client-0569749083-442d2bdcffc6.json
gen-lang-client-*.json
*-service-account*.json
*credentials*.json
secrets/


# ── python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.python-version

